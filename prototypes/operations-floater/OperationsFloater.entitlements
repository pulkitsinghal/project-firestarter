<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Distribution posture: Developer ID (direct) + Hardened Runtime, NOT sandboxed.
	  See docs/SIGNING.md for the distribution and code-signing analysis.

	  The only entitlement required is the Hardened Runtime microphone
	  resource-access exception, used by the voice conversation feature. Speech
	  Recognition carries no entitlement; it is gated purely by TCC at runtime
	  (NSSpeechRecognitionUsageDescription). Network and user-selected file access
	  are unrestricted once the sandbox is removed, so the former sandbox-only keys
	  are dropped as no-ops.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
