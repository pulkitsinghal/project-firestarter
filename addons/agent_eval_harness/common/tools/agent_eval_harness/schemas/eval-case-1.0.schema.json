{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firestarter:agent-eval-harness:eval-case:1.0",
  "title": "Deterministic agent-evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "inputFixtureRef", "checks"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "caseId": {"$ref": "#/$defs/opaqueId"},
    "inputFixtureRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureId", "digest"],
      "properties": {
        "fixtureId": {"$ref": "#/$defs/opaqueId"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "numericComparator": {
      "enum": ["ge", "le", "gt", "lt", "eq"]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "kind", "blocking", "evidenceId", "fieldToken", "params"],
      "properties": {
        "checkId": {"$ref": "#/$defs/opaqueId"},
        "kind": {
          "enum": [
            "exact-equals",
            "subset",
            "regex-match",
            "numeric-threshold",
            "ordered-contains"
          ]
        },
        "blocking": {"type": "boolean"},
        "evidenceId": {"$ref": "#/$defs/opaqueId"},
        "fieldToken": {"$ref": "#/$defs/opaqueId"},
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected": {},
            "pattern": {"type": "string", "minLength": 1, "maxLength": 200},
            "comparator": {"$ref": "#/$defs/numericComparator"},
            "bound": {"type": "number"}
          }
        }
      }
    }
  }
}
