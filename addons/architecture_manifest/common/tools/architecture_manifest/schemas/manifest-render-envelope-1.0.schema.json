{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firestarter:architecture-manifest:manifest-render-envelope:1.0",
  "title": "Manifest render envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "artifactKind",
    "manifestId",
    "componentCount",
    "dataStoreCount",
    "dependencyCount",
    "boundaryCount",
    "contentDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "toolVersion": {"const": "0.1.0"},
    "artifactKind": {"enum": ["mermaid", "anatomy"]},
    "manifestId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"},
    "componentCount": {"type": "integer", "minimum": 1, "maximum": 256},
    "dataStoreCount": {"type": "integer", "minimum": 0, "maximum": 256},
    "dependencyCount": {"type": "integer", "minimum": 0, "maximum": 512},
    "boundaryCount": {"type": "integer", "minimum": 1, "maximum": 64},
    "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
