{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firestarter:reviewed-extraction:egress-payload:1.0",
  "title": "Allowlisted egress payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "purpose",
    "recipientId",
    "fields",
    "droppedFieldPaths",
    "fieldCount",
    "payloadDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contractVersion": {"const": "0.1.0"},
    "purpose": {
      "enum": ["treatment", "payment", "operations", "research", "patient-access"]
    },
    "recipientId": {"$ref": "#/$defs/opaqueId"},
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fieldPath",
          "value",
          "decisionState",
          "actorId",
          "sourceId",
          "sourceDigest"
        ],
        "properties": {
          "fieldPath": {"$ref": "#/$defs/fieldPath"},
          "value": {"$ref": "#/$defs/valueToken"},
          "decisionState": {"enum": ["confirmed", "corrected"]},
          "actorId": {"$ref": "#/$defs/opaqueId"},
          "sourceId": {"$ref": "#/$defs/opaqueId"},
          "sourceDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "droppedFieldPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fieldPath", "code"],
        "properties": {
          "fieldPath": {"$ref": "#/$defs/fieldPath"},
          "code": {
            "enum": [
              "dropped-no-decision",
              "dropped-not-releasable",
              "dropped-purpose-mismatch",
              "dropped-recipient-mismatch"
            ]
          }
        }
      }
    },
    "fieldCount": {"type": "integer", "minimum": 0},
    "payloadDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "fieldPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}(?:\\.[A-Za-z0-9][A-Za-z0-9_-]{0,63}){0,15}$"
    },
    "valueToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
