{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:firestarter:browser-automation-policy:capability-grant:1.0",
  "title": "Browser automation capability grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "grantId",
    "taskId",
    "allowedOriginIds",
    "allowedFrameOriginChains",
    "allowedAdapters",
    "allowedEffects",
    "allowedActionTargets",
    "allowGeometryFallback",
    "expiresAtTick"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "grantId": {"$ref": "#/$defs/opaqueId"},
    "taskId": {"$ref": "#/$defs/opaqueId"},
    "allowedOriginIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "allowedFrameOriginChains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {"$ref": "#/$defs/opaqueId"}
      }
    },
    "allowedAdapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["semantic-dom", "relative-xy", "citrix-remote"]}
    },
    "allowedEffects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["observe", "navigate", "edit-draft", "external-submit", "destructive"]
      }
    },
    "allowedActionTargets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "action",
          "effect",
          "targetKind",
          "targetContractDigest"
        ],
        "properties": {
          "adapter": {
            "enum": ["semantic-dom", "relative-xy", "citrix-remote"]
          },
          "action": {
            "enum": [
              "observe",
              "focus",
              "activate",
              "set-value",
              "clear-value",
              "select",
              "navigate",
              "external-send",
              "submit",
              "delete",
              "grant-permission",
              "upload"
            ]
          },
          "effect": {
            "enum": [
              "observe",
              "navigate",
              "edit-draft",
              "external-submit",
              "destructive"
            ]
          },
          "targetKind": {
            "enum": ["semantic", "relative-region", "remote-region"]
          },
          "targetContractDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "allowGeometryFallback": {"type": "boolean"},
    "expiresAtTick": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
