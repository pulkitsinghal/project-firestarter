      "retain": false
    },
    {
      "id": "synthetic-api",
      "adapter": "synthetic",
      "upstream": "http://127.0.0.1:18882",
      "dependencies": [
        "synthetic-cache"
      ],
      "health": {
        "path": "/healthz",
        "interval_ms": 25
      },
      "wake_timeout_ms": 1000,
      "idle_timeout_ms": 30000,
      "drain_grace_ms": 250,
      "never_stop": false,
      "retain": false
    }
  ]
}
