{
  "schema_version": 1,
  "services": [
    {
      "id": "synthetic-cache",
      "adapter": "synthetic",
      "upstream": "http://127.0.0.1:18881",
      "dependencies": [],
      "health": {
        "path": "/healthz",
        "interval_ms": 25
      },
      "wake_timeout_ms": 1000,
