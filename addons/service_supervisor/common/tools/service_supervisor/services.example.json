{
  "schema_version": 1,
  "services": [
    {
      "id": "synthetic-cache",
      "adapter": "synthetic",
      "upstream": "http://127.0.0.1:18881",
      "dependencies": [],
      "health": {
        "path": "/healthz",
        "interval_ms": 25
      },
      "wake_timeout_ms": 1000,
      "idle_timeout_ms": 30000,
      "drain_grace_ms": 250,
      "never_stop": false,
      "retain": false
    },
    {
      "id": "synthetic-api",
      "adapter": "synthetic",
      "upstream": "http://127.0.0.1:18882",
      "dependencies": [
        "synthetic-cache"
      ],
      "health": {
        "path": "/healthz",
        "interval_ms": 25
      },
      "wake_timeout_ms": 1000,
      "idle_timeout_ms": 30000,
      "drain_grace_ms": 250,
      "never_stop": false,
      "retain": false,
      "recovery": {
        "liveness": {
          "path": "/serves",
          "interval_ms": 25
        },
        "revive": {
          "enabled": false,
          "max_attempts": 3,
          "cooldown_ms": 60000
        },
        "failover": {
          "enabled": false,
          "target": "synthetic-cache",
          "retest_interval_ms": 300000
        }
      }
    }
  ]
}
