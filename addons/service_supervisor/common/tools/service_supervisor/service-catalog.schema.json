{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.local/schemas/service-supervisor-catalog-1.json",
  "title": "Firestarter service supervisor catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "upstream",
        "health",
        "wake_timeout_ms",
        "idle_timeout_ms",
        "drain_grace_ms"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "adapter": {
          "const": "synthetic"
        },
        "upstream": {
          "type": "string",
          "pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\]):[1-9][0-9]{0,4}/?$"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "default": []
        },
        "health": {
          "$ref": "#/$defs/health"
        },
        "wake_timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300000
        },
        "idle_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "drain_grace_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "never_stop": {
          "type": "boolean",
          "default": false
        },
        "retain": {
          "type": "boolean",
          "default": false
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "interval_ms"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]{0,255}$"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveness"
      ],
      "properties": {
        "liveness": {
          "$ref": "#/$defs/liveness"
        },
        "revive": {
          "$ref": "#/$defs/revive"
        },
        "failover": {
          "$ref": "#/$defs/failover"
        }
      }
    },
    "liveness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "interval_ms"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]{0,255}$"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "revive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_attempts",
        "cooldown_ms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "cooldown_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "retest_interval_ms"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$"
        },
        "retest_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    }
  }
}
