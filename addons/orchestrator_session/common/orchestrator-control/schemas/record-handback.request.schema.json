{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/record-handback-request-1.0.schema.json",
  "title": "record-handback request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "handback_id", "task_id", "policy_snapshot_revision", "lease_epoch", "fencing_token", "disposition", "exact_refs", "checks", "review_findings", "hosted_ci", "deployment_state", "privacy_boundary", "artifacts", "resources", "dependencies", "next_action", "successor_request", "block", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "handback_id": {"type": "string"},
    "task_id": {"type": "string"},
    "policy_snapshot_revision": {"type": "integer", "minimum": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "disposition": {"enum": ["completed", "blocked", "failed", "superseded", "duplicate"]},
    "exact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "candidate_sha", "pr_url", "merge_sha", "default_sha"],
      "properties": {
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "candidate_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "pr_url": {"type": ["string", "null"]},
        "merge_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "default_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "result", "evidence_ref"],
        "properties": {
          "name": {"type": "string"},
          "scope": {"type": "string"},
          "result": {"enum": ["pass", "fail", "pending", "skipped", "blocked", "unexecuted"]},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "review_findings": {"type": "array", "items": {"type": "string"}},
    "hosted_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "cause"],
      "properties": {
        "status": {"enum": ["pass", "fail", "pending", "skipped", "cancelled", "unexecuted", "unavailable"]},
        "steps": {"type": "integer", "minimum": 0},
        "cause": {"type": "string"}
      }
    },
    "deployment_state": {"enum": ["not_performed", "local_only", "owner_authorized_deployed", "unavailable"]},
    "privacy_boundary": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "disposition", "reason"],
        "properties": {
          "id": {"type": "string"},
          "disposition": {"enum": ["retain", "remove", "removed"]},
          "reason": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "successor_request": {
      "oneOf": [
        {"$ref": "prepare-launch.request.schema.json"},
        {"type": "null"}
      ]
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "reason_code", "evidence_refs"],
          "properties": {
            "classification": {"enum": ["owner_gate", "dependency", "resource_budget", "transient_tool", "zero_step_ci", "stale_dashboard", "completed_external", "policy_conflict", "unknown"]},
            "reason_code": {"type": "string"},
            "evidence_refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        {"type": "null"}
      ]
    },
    "now": {"type": "string"}
  }
}
