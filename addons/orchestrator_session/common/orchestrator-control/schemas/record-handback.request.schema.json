{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/record-handback-request-1.0.schema.json",
  "title": "record-handback request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "handback_id", "task_id", "policy_snapshot_revision", "lease_epoch", "fencing_token", "external_thread_id", "disposition", "exact_refs", "checks", "review_findings", "hosted_ci", "deployment_state", "privacy_boundary", "artifacts", "resources", "dependencies", "next_action", "successor_request", "block", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "handback_id": {"type": "string"},
    "task_id": {"type": "string"},
    "policy_snapshot_revision": {"type": "integer", "minimum": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "external_thread_id": {"type": "string"},
    "disposition": {"enum": ["completed", "completed_local_only", "completed_local_artifact", "blocked", "failed", "superseded", "duplicate"]},
    "exact_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "candidate_sha", "pr_url", "merge_sha", "default_sha"],
      "properties": {
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "candidate_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "pr_url": {"type": ["string", "null"]},
        "merge_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "default_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "result", "evidence_ref"],
        "properties": {
          "name": {"type": "string"},
          "scope": {"type": "string"},
          "result": {"enum": ["pass", "fail", "pending", "skipped", "blocked", "unexecuted"]},
          "evidence_ref": {"type": "string"}
        }
      }
    },
    "review_findings": {"type": "array", "items": {"type": "string"}},
    "hosted_ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "steps", "cause"],
      "properties": {
        "status": {"enum": ["pass", "fail", "pending", "skipped", "cancelled", "unexecuted", "unavailable"]},
        "steps": {"type": "integer", "minimum": 0},
        "cause": {"type": "string"}
      }
    },
    "deployment_state": {"enum": ["not_performed", "local_only", "owner_authorized_deployed", "unavailable"]},
    "external_delivery": {"enum": ["not_performed", "performed", "unavailable"]},
    "privacy_boundary": {"type": "string"},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "local_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "entries", "manifest_sha256", "rollback"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relative_path", "transition", "before_sha256", "after_sha256"],
            "properties": {
              "relative_path": {"type": "string", "minLength": 1, "maxLength": 512},
              "transition": {"enum": ["created", "modified", "removed"]},
              "before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "after_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "evidence_ref"],
          "properties": {
            "strategy": {"const": "restore_base"},
            "evidence_ref": {"type": "string"}
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "disposition", "reason"],
        "properties": {
          "id": {"type": "string"},
          "disposition": {"enum": ["retain", "remove", "removed"]},
          "reason": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "public_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicLabel", "ownerClass", "laneClass"],
      "properties": {
        "publicLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,&()'’+-]{0,79}$"
        },
        "ownerClass": {"enum": ["pm-proxy", "worker", "owner", "external"]},
        "laneClass": {"enum": ["running", "next", "waiting", "owner-gated", "complete"]}
      }
    },
    "successor_request": {
      "oneOf": [
        {"$ref": "prepare-launch.request.schema.json"},
        {"type": "null"}
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured_capacity", "runnable_queue_count", "terminal_status", "clean_handback", "empty_outcome", "evidence_refs", "blocked_audits"],
      "properties": {
        "configured_capacity": {"type": "integer", "minimum": 1, "maximum": 64},
        "runnable_queue_count": {"type": "integer", "minimum": 0},
        "terminal_status": {"enum": ["completed", "archived", "interrupted/notLoaded"]},
        "clean_handback": {"const": true},
        "empty_outcome": {"enum": ["EMPTY", "OWNER_GATED"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "blocked_audits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "classification", "outcome", "reason_code", "evidence_refs"],
            "properties": {
              "task_id": {"type": "string"},
              "classification": {"enum": ["owner_gate", "dependency", "resource_budget", "transient_tool", "zero_step_ci", "stale_dashboard", "completed_external", "policy_conflict", "unknown"]},
              "outcome": {"enum": ["resume", "archive", "remain_blocked", "owner_gate"]},
              "reason_code": {"type": "string"},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "reason_code", "evidence_refs"],
          "properties": {
            "classification": {"enum": ["owner_gate", "dependency", "resource_budget", "transient_tool", "zero_step_ci", "stale_dashboard", "completed_external", "policy_conflict", "unknown"]},
            "reason_code": {"type": "string"},
            "evidence_refs": {"type": "array", "items": {"type": "string"}}
          }
        },
        {"type": "null"}
      ]
    },
    "now": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"not": {"const": "blocked"}}}},
      "then": {"required": ["capacity"]}
    },
    {
      "if": {"properties": {"disposition": {"enum": ["completed_local_only", "completed_local_artifact"]}}},
      "then": {
        "required": ["external_delivery"],
        "properties": {
          "external_delivery": {"const": "not_performed"},
          "deployment_state": {"const": "not_performed"},
          "hosted_ci": {
            "properties": {
              "status": {"const": "unexecuted"},
              "steps": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "completed_local_artifact"}}},
      "then": {"required": ["local_artifact"]}
    }
  ]
}
