{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/activate-federation-request-1.0.schema.json",
  "title": "activate-federation request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface_version",
    "request_id",
    "transfer_id",
    "source_finalize_receipts",
    "evidence_refs",
    "now"
  ],
  "properties": {
    "interface_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "transfer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_finalize_receipts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "https://firestarter.invalid/orchestrator-control/authority-transfer-receipt-1.0.schema.json"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "now": {
      "type": "string"
    }
  }
}
