{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/record-duration-observation-request-1.0.schema.json",
  "title": "record-duration-observation request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "sample_id", "task_id", "policy_snapshot_revision", "lease_epoch", "fencing_token", "external_thread_id", "completed", "actual", "evidence_refs", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "sample_id": {"type": "string"},
    "task_id": {"type": "string"},
    "policy_snapshot_revision": {"type": "integer", "minimum": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "external_thread_id": {"type": "string"},
    "completed": {"const": true},
    "actual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_seconds", "queue_seconds", "setup_seconds", "tool_wait_seconds", "external_wait_seconds", "total_wall_seconds", "first_evidence_seconds", "safe_close_seconds"],
      "properties": {
        "active_seconds": {"type": "integer", "minimum": 0},
        "queue_seconds": {"type": ["integer", "null"], "minimum": 0},
        "setup_seconds": {"type": ["integer", "null"], "minimum": 0},
        "tool_wait_seconds": {"type": ["integer", "null"], "minimum": 0},
        "external_wait_seconds": {"type": ["integer", "null"], "minimum": 0},
        "total_wall_seconds": {"type": ["integer", "null"], "minimum": 0},
        "first_evidence_seconds": {"type": ["integer", "null"], "minimum": 0},
        "safe_close_seconds": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "now": {"type": "string"}
  }
}
