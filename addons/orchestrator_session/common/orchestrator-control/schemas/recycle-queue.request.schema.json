{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/recycle-queue-request-1.0.schema.json",
  "title": "recycle-queue request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "audits", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "classification", "outcome", "reason_code", "evidence_refs"],
        "properties": {
          "task_id": {"type": "string"},
          "classification": {"enum": ["owner_gate", "dependency", "resource_budget", "transient_tool", "zero_step_ci", "stale_dashboard", "completed_external", "policy_conflict", "unknown"]},
          "outcome": {"enum": ["resume", "archive", "remain_blocked", "owner_gate"]},
          "reason_code": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "now": {"type": "string"}
  }
}
