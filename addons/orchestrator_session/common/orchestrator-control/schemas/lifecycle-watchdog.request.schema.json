{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/lifecycle-watchdog-request-1.0.schema.json",
  "title": "lifecycle-watchdog request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface_version",
    "request_id",
    "task_id",
    "policy_snapshot_revision",
    "lease_epoch",
    "fencing_token",
    "external_thread_id",
    "action",
    "trigger",
    "worker_status",
    "completion_signals",
    "evidence_refs",
    "remaining_work",
    "interrupt_receipt",
    "capacity",
    "now"
  ],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "task_id": {"type": "string"},
    "policy_snapshot_revision": {"type": "integer", "minimum": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "external_thread_id": {"type": "string"},
    "action": {"enum": ["observe", "interrupt-receipt"]},
    "trigger": {
      "enum": [
        "before-status-claim",
        "interrupt-receipt",
        "wait-timeout",
        "worker-message"
      ]
    },
    "worker_status": {
      "enum": ["completed", "interrupted", "running", "unknown", "waiting"]
    },
    "completion_signals": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "closure-signal",
          "objective-complete",
          "output-ready",
          "terminal-manifest",
          "tests-passed"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {"type": "string"}
    },
    "remaining_work": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary_code", "progress_ref", "observed_at", "eta_seconds"],
          "properties": {
            "summary_code": {"type": "string"},
            "progress_ref": {"type": "string"},
            "observed_at": {"type": "string"},
            "eta_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        }
      ]
    },
    "interrupt_receipt": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_id", "external_thread_id"],
          "properties": {
            "receipt_id": {"type": "string"},
            "external_thread_id": {"type": "string"}
          }
        }
      ]
    },
    "capacity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configured_capacity",
            "runnable_queue_count",
            "empty_outcome",
            "evidence_refs",
            "blocked_audits",
            "successor_request"
          ],
          "properties": {
            "configured_capacity": {"type": "integer", "minimum": 1, "maximum": 64},
            "runnable_queue_count": {"type": "integer", "minimum": 0},
            "empty_outcome": {"enum": ["EMPTY", "OWNER_GATED"]},
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string"}
            },
            "blocked_audits": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "task_id",
                  "classification",
                  "outcome",
                  "reason_code",
                  "evidence_refs"
                ],
                "properties": {
                  "task_id": {"type": "string"},
                  "classification": {
                    "enum": [
                      "owner_gate",
                      "dependency",
                      "resource_budget",
                      "transient_tool",
                      "zero_step_ci",
                      "stale_dashboard",
                      "completed_external",
                      "policy_conflict",
                      "unknown"
                    ]
                  },
                  "outcome": {
                    "enum": ["resume", "archive", "remain_blocked", "owner_gate"]
                  },
                  "reason_code": {"type": "string"},
                  "evidence_refs": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            },
            "successor_request": {
              "oneOf": [
                {"$ref": "prepare-launch.request.schema.json"},
                {"type": "null"}
              ]
            }
          }
        }
      ]
    },
    "now": {"type": "string"}
  }
}
