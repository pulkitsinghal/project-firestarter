{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/prepare-launch-request-1.0.schema.json",
  "title": "prepare-launch request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "source_event_key", "idempotency_key", "outcome_key", "task_id", "title", "prompt", "priority", "target", "context", "dependencies", "permissions", "prohibitions", "privacy_boundary", "evidence_contract", "cleanup_duty", "lease_expires_at", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "source_event_key": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "outcome_key": {"type": "string"},
    "task_id": {"type": "string"},
    "title": {"type": "string"},
    "prompt": {"type": "string"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "repo_root", "path", "base_sha", "resource_mode"],
      "properties": {
        "remote": {"type": "string"},
        "repo_root": {"type": "string"},
        "path": {"type": "string"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "resource_mode": {"enum": ["repo-wide", "path"]}
      }
    },
    "context": {"$ref": "shared.schema.json#/$defs/context"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "prohibitions": {"type": "array", "items": {"type": "string"}},
    "privacy_boundary": {"type": "string"},
    "evidence_contract": {"type": "array", "items": {"type": "string"}},
    "cleanup_duty": {"type": "array", "items": {"type": "string"}},
    "duration_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate_version",
        "estimated_bucket",
        "confidence",
        "task_family",
        "tool_family",
        "environment_class",
        "evidence_basis",
        "expected_components",
        "heavyweight_concurrency_cap"
      ],
      "properties": {
        "estimate_version": {"type": "integer", "minimum": 1},
        "estimated_bucket": {"enum": ["seconds", "5m", "10m", "15m", "20m", "30m", "45m", "60m+"]},
        "confidence": {"enum": ["low", "moderate", "high"]},
        "task_family": {"type": "string"},
        "tool_family": {"type": "string"},
        "environment_class": {"type": "string"},
        "evidence_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected_components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["setup_seconds", "test_seconds", "remote_wait_seconds"],
          "properties": {
            "setup_seconds": {"type": ["integer", "null"], "minimum": 0},
            "test_seconds": {"type": ["integer", "null"], "minimum": 0},
            "remote_wait_seconds": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "heavyweight_concurrency_cap": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "lease_expires_at": {"type": "string"},
    "now": {"type": "string"}
  }
}
