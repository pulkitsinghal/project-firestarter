{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/policy-ledger-1.0.schema.json",
  "title": "Orchestrator policy ledger 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_version", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "ledger_version": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "id", "rule_revision", "state", "scope", "precedence_tier", "priority", "effect", "directive", "gate_code", "provenance", "effective_at", "expires_at", "supersedes", "conflict_group", "privacy"],
        "properties": {
          "schema_version": {"const": "1.0"},
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
          "rule_revision": {"type": "integer", "minimum": 1},
          "state": {"enum": ["active", "superseded", "expired", "revoked", "quarantined"]},
          "scope": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "owner": {"type": "string"},
              "org": {"type": "string"},
              "repo": {"type": "string"},
              "path": {"type": "string"},
              "environment": {"type": "string"},
              "data_class": {"type": "string"},
              "action": {"type": "string"},
              "task_kind": {"type": "string"}
            }
          },
          "precedence_tier": {"type": "integer", "minimum": 1, "maximum": 6},
          "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
          "effect": {"enum": ["allow_pm_proxy", "require_owner", "deny", "constraint", "annotate"]},
          "directive": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "summary", "args"],
            "properties": {
              "code": {"type": "string"},
              "summary": {"type": "string"},
              "args": {"type": "object", "maxProperties": 0}
            }
          },
          "gate_code": {
            "enum": [
              null,
              "ACCOUNT_ACCESS",
              "AUTH_CHALLENGE",
              "BILLING_CHANGE_OR_SPEND",
              "DESTRUCTIVE_UNIQUE_DATA",
              "EXTERNAL_COMMUNICATION",
              "FORCE_HISTORY",
              "HARDWARE_MUTATION",
              "MATERIAL_SCOPE_CHANGE",
              "PRIVACY_CLINICAL_LEGAL_GOVERNED",
              "PRODUCTION_CHANGE",
              "PRODUCTION_DATA_MIGRATION",
              "PRODUCTION_DEPLOY",
              "PRODUCTION_RELEASE",
              "PROTECTION_BYPASS",
              "ANY_ENUMERATED"
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_kind", "source_thread_id", "source_turn_id", "recorded_at", "redacted_summary"],
            "properties": {
              "source_kind": {"enum": ["canonical", "owner-decision", "repo-policy", "team-policy", "environment-policy", "learned-preference"]},
              "source_thread_id": {"type": ["string", "null"]},
              "source_turn_id": {"type": ["string", "null"]},
              "recorded_at": {"type": "string"},
              "redacted_summary": {"type": "string"}
            }
          },
          "effective_at": {"type": "string"},
          "expires_at": {"type": ["string", "null"]},
          "supersedes": {"type": "array", "items": {"type": "string"}},
          "conflict_group": {"type": ["string", "null"]},
          "privacy": {"enum": ["public-policy", "local-redacted"]}
        }
      }
    }
  }
}
