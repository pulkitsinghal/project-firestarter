{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/acknowledge-control-schema-hold-request-1.0.schema.json",
  "title": "acknowledge-control-schema-hold request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interface_version",
    "request_id",
    "authorization_request_id",
    "decision_request_id",
    "decision_id",
    "decision",
    "root_thread_id",
    "ticket_id",
    "task_id",
    "external_thread_id",
    "expected_state_revision",
    "expected_policy_revision",
    "expected_configured_capacity",
    "policy_snapshot_revision",
    "lease_epoch",
    "fencing_token",
    "replay_target",
    "now"
  ],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "authorization_request_id": {"type": "string"},
    "decision_request_id": {"type": "string"},
    "decision_id": {"type": "string"},
    "decision": {"const": "CONTROL_SCHEMA_DEFECT_NO_TRUTHFUL_TERMINAL_ROUTE"},
    "root_thread_id": {"type": "string"},
    "ticket_id": {"type": "string"},
    "task_id": {"type": "string"},
    "external_thread_id": {"type": "string"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "expected_policy_revision": {"type": "integer", "minimum": 1},
    "expected_configured_capacity": {"type": "integer", "minimum": 1, "maximum": 64},
    "policy_snapshot_revision": {"type": "integer", "minimum": 1},
    "lease_epoch": {"type": "integer", "minimum": 1},
    "fencing_token": {"type": "integer", "minimum": 1},
    "replay_target": {"const": "completed_local_only"},
    "now": {"type": "string"}
  }
}
