{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/capacity-watchdog-request-1.0.schema.json",
  "title": "capacity-watchdog request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "request_id", "saga_id", "configured_capacity", "runnable_queue_count", "empty_outcome", "evidence_refs", "successor_request", "now"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "request_id": {"type": "string"},
    "saga_id": {"type": "string"},
    "configured_capacity": {"type": "integer", "minimum": 1, "maximum": 64},
    "runnable_queue_count": {"type": "integer", "minimum": 0},
    "empty_outcome": {"enum": ["EMPTY", "OWNER_GATED"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "successor_request": {
      "oneOf": [
        {"$ref": "prepare-launch.request.schema.json"},
        {"type": "null"}
      ]
    },
    "blocked_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "classification", "outcome", "reason_code", "evidence_refs"],
        "properties": {
          "task_id": {"type": "string"},
          "classification": {"enum": ["owner_gate", "dependency", "resource_budget", "transient_tool", "zero_step_ci", "stale_dashboard", "completed_external", "policy_conflict", "unknown"]},
          "outcome": {"enum": ["resume", "archive", "remain_blocked", "owner_gate"]},
          "reason_code": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "now": {"type": "string"}
  }
}
