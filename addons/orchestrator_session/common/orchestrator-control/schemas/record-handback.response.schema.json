{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firestarter.invalid/orchestrator-control/record-handback-response-1.0.schema.json",
  "title": "record-handback success response 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["interface_version", "ok", "operation", "result"],
  "properties": {
    "interface_version": {"const": "1.0"},
    "ok": {"const": true},
    "operation": {"const": "record-handback"},
    "result": {
      "type": "object",
      "required": ["task_id", "state"],
      "properties": {
        "task_id": {"type": "string"},
        "state": {"enum": ["BLOCKED", "ARCHIVE_PENDING"]},
        "audit_required": {"type": "boolean"},
        "archive_outbox_id": {"type": "string"},
        "successor": {"type": ["object", "null"]},
        "capacity": {"type": "object"},
        "evidence_count": {"type": "integer"},
        "resource_count": {"type": "integer"},
        "reclaimed_bytes": {"type": "integer"},
        "local_artifact_manifest_sha256": {"type": ["string", "null"]},
        "control_schema_hold_released": {"type": "boolean"}
      }
    }
  }
}
