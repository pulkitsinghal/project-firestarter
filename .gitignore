# Firestarter's own ignores. (template/.gitignore is the one stamped into new
# projects — don't confuse the two.)
.DS_Store
*.swp
.idea/
.vscode/

# Generator scratch / smoke-test output
/tmp/
*.local.json
answers.json

# Local working notes. This repo's origin is PUBLIC — scratchpad/ accumulates
# untracked working files (ops notes naming live infra, personal working sets)
# that must never be swept in by a stray `git add -A`.
scratchpad/
