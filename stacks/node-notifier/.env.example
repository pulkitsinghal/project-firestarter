# {{ project_name }} — environment manifest.
# Local tutorial defaults are safe only on loopback. Production settings are
# intentionally not filled; see docs/production.md before enabling OIDC.

HOST_PORT={{ port_web }}
PUBLIC_ORIGIN=http://localhost:{{ port_web }}
TASK_DELAY_MS=1200
WORKER_CONCURRENCY=4
TASK_RETENTION_SECONDS=86400
TASK_RATE_LIMIT=30
TASK_RATE_WINDOW_SECONDS=60
REPLAY_LIMIT=50

# Never reuse the checked-in local Compose secret outside the tutorial.
# Production operators inject these with a secret/config system:
# NODE_ENV=production
# AUTH_MODE=oidc
# SESSION_SECRET=__REPLACE_ME__
# OIDC_ISSUER=https://identity.example/
# OIDC_AUDIENCE=https://{{ project_slug }}.example/api
# OIDC_JWKS_URL=https://identity.example/.well-known/jwks.json
# REDIS_URL=rediss://{{ project_slug }}:__REPLACE_ME__@redis.example:6380/0
