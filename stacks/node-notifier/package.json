{
  "name": "{{ project_slug }}",
  "version": "0.1.0",
  "description": "{{ project_tagline }}",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/start-api.js",
    "start:worker": "node src/start-worker.js",
    "dev": "node --watch src/start-api.js",
    "dev:worker": "node --watch src/start-worker.js",
    "check": "find src public test storyboard \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "bullmq": "5.81.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.4",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "socket.io-client": "4.8.3"
  },
  "license": "Apache-2.0"
}
