#!/bin/sh
#
# Pre-commit hook: always scans the immutable staged index for repository hygiene.
# Source changes then run `make precommit`; docs-only changes run the fast
# dependency-free documentation guard. Both paths keep the immutable hygiene
# scan above as their first gate.
#
# Enable per-checkout via:
#   make hook-install
# Or directly:
#   git config core.hooksPath .githooks
#
# Skip with: git commit --no-verify

echo "▶ pre-commit: scanning staged repository hygiene..."
make repo-hygiene
rc=$?
if [ $rc -ne 0 ]; then
    echo ""
    echo "✗ repository hygiene failed (exit $rc)."
    exit $rc
fi

CHANGED=$(git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null)
rc=$?
if [ $rc -ne 0 ]; then
    echo "✗ unable to classify the staged index."
    exit 2
fi

# Source globs across the supported stacks. Add yours here if it differs.
if echo "$CHANGED" | grep -qiE '(^|/)([^/]+\.(md|markdown))$|^VERSION$'; then
    echo "▶ pre-commit: checking the staged documentation snapshot..."
    bash scripts/check-docs.sh --staged
    rc=$?
    if [ $rc -ne 0 ]; then
        echo ""
        echo "✗ staged documentation integrity failed (exit $rc)."
        exit $rc
    fi
fi

if echo "$CHANGED" | grep -qE '^(backend|frontend|app|splash|services|extension|src|test|public|e2e|storyboard|scripts)/|(pyproject\.toml|package\.json|pubspec\.yaml)$'; then
    echo "▶ pre-commit: running precommit gates (Docker)..."
    make precommit
    rc=$?
    if [ $rc -ne 0 ]; then
        echo ""
        echo "✗ pre-commit failed (exit $rc). Fix issues or run with --no-verify to skip."
        exit $rc
    fi
fi

exit 0
