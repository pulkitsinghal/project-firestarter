# ── Env / secrets ────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.deploy
!.env.example
# secret_vault add-on: local secret backups + restored git-crypt key files.
# Never commit a secret even if SECRET_VAULT_HOME is pointed inside the repo.
.secret-vault/
git-crypt-*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node / Next.js / Vite ────────────────────────────────────────────────────
# No trailing slash: `node_modules/` only matches a real directory, so a
# SYMLINKED node_modules (e.g. a git worktree pointing at the main checkout's
# install) slips through `git add`. `node_modules` (no slash) ignores the dir,
# a symlink, or a stray file of that name.
node_modules
.next/
out/
dist/
.turbo/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# ── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
.packages
build/
*.iml

# ── Docker volume scratch ────────────────────────────────────────────────────
.docker-data/

# ── Bounded runner local records / cross-run admission locks ────────────────
.bounded-runner/
.bounded-runner-locks/

# ── Mutation-check private crash-recovery journal ────────────────────────────
.mutation-check.lock/

# ── Cloud DB recovery one-use authorization + outcome journal ───────────────
.firestarter/cloud-db-recovery/

# ── Storyboard output (generated screenshots) ────────────────────────────────
storyboard/output/*.png
storyboard/output/*.mp4

# ── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Claude Code ──────────────────────────────────────────────────────────────
# The SHARED config is committed on purpose (.claude/settings.json + hooks/ give
# every session the same guardrails — see .claude/README.md), so it is NOT
# ignored here. Ignore only PERSONAL/local state so it can't be swept into a
# commit: your own settings.local.json overrides and local worktree scratch.
.claude/settings.local.json
.claude/worktrees/

# ── Cloudflare named-tunnel secrets ──────────────────────────────────────────
# The filled-in config + the credentials JSON are per-owner tunnel secrets;
# `deploy/cloudflared/config.example.yml` is the tracked template (see DEPLOY.md).
deploy/cloudflared/config.yml
deploy/cloudflared/*.json

# ── Convergent-deploy manifest + fence (credential-class) ─────────────────────
# The convergent_deploy add-on writes these two files INTO the published site;
# never commit them. `_deployed.json` enumerates every published id, and an
# unlisted slug is the unguessable half of its URL, so a tracked list of them
# (worse, beside human-readable titles) is a link dump one repo-visibility flip
# from publishing every link at once, history intact. Both are regenerable: the
# deploy rebuilds them and the live site is authoritative, so a clone never needs
# them. Inert until the add-on is enabled. See docs/UNLISTED_PUBLISHING.md.
_deployed.json
_deploy-state.json
